#!/bin/sh

set -e

SYSTEMD_USER_DIR=usr/lib/systemd/user

if [ ! -d $SYSTEMD_USER_DIR ]; then
    echo "$SYSTEMD_USER_DIR folder is missing"
    exit 1
fi

# We allow just a couple we know to be innocuous because they just make a qdbus or dbus-send call
SERVICE_FILES=`find $SYSTEMD_USER_DIR -maxdepth 1 -type f,l -size +0c -name "*.service" | \
    grep -v -E "(plasma-ksplash-ready|plasma-kcminit-phase1|plasma-restoresession)" | \
    cat`

if [ -n "$SERVICE_FILES" ]; then
    echo "Found non-empty service files which need to be removed:"
    echo $SERVICE_FILES
    exit 1
fi

for unit in drkonqi-sentry-postman.path drkonqi-sentry-postman.timer; do
    if [ -e "$SYSTEMD_USER_DIR/$unit" ] || [ -L "$SYSTEMD_USER_DIR/$unit" ]; then
        echo "Found orphaned crash reporter unit: $SYSTEMD_USER_DIR/$unit"
        exit 1
    fi
    if find "$SYSTEMD_USER_DIR" -type l -name "$unit" | grep -q .; then
        echo "Found enabled link for orphaned crash reporter unit: $unit"
        exit 1
    fi
done

POLKIT_OVERRIDE="$SYSTEMD_USER_DIR/snap.plasma-desktop-session.plasma-polkit-agent.service.d/override.conf"
if ! grep -qx 'ConditionUser=!sddm' "$POLKIT_OVERRIDE"; then
    echo "The polkit agent must not start in the SDDM greeter user manager"
    exit 1
fi
